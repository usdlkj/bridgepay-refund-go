# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=25s
DEPENDENCY_HEALTH_TIMEOUT=2s

# PostgreSQL: DATABASE_URL may replace the DB_* fields.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bridgepay_refund
DB_SSL_MODE=disable
# DB_CA_PATH=/run/secrets/postgres-ca

# Redis and RabbitMQ
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://user:password@localhost:5672
RABBITMQ_QUEUE=bridgepay-refund
RABBITMQ_ENCRYPTOR_QUEUE=bridgepay-encryptor
# Keep false while Node Refund owns bridgepay-refund. Enable only after the Go
# business handlers for the intended cutover are registered.
RABBITMQ_CONSUMER_ENABLED=false
RABBITMQ_PREFETCH=16
RABBITMQ_RETRY_DELAY=60s
RABBITMQ_MAX_RETRIES=3

# Keep false while Node Refund owns the 04:00/05:00 WIB report schedules.
# Enable only as part of the Refund-Go scheduler cutover.
REPORT_SCHEDULER_ENABLED=false

# Typed Refund-Go -> Core-Go transport.
CORE_GRPC_ADDRESS=localhost:50051
# Required together in staging/production. Mount the same trusted CA/client
# identity used by other internal Go services.
CORE_GRPC_TLS_CA_FILE=
CORE_GRPC_TLS_CERT_FILE=
CORE_GRPC_TLS_KEY_FILE=
CORE_GRPC_TLS_SERVER_NAME=

# Synchronous Gateway-Go -> Refund-Go gRPC server. Plaintext is local-only;
# staging and production require mTLS and the Gateway certificate DNS name.
REFUND_GRPC_LISTEN_ADDRESS=:50052
REFUND_GRPC_TLS_CERT_FILE=
REFUND_GRPC_TLS_KEY_FILE=
REFUND_GRPC_TLS_CLIENT_CA_FILE=
REFUND_GRPC_ALLOWED_CLIENT_NAME=

# Provider reachability. No credentials are sent by health checks.
EXTERNAL_HEALTH_CHECKS=true
ILUMA_BASE_URL=https://api.iluma.ai
XENDIT_BASE_URL=https://api.xendit.co
ILUMA_HTTP_TIMEOUT=10s
BANK_ACCOUNT_CHECK_TTL_DAYS=10
CHECK_ACCOUNT_MAX_WAIT_MS=7000
CHECK_ACCOUNT_MIN_SLEEP_MS=500
CHECK_ACCOUNT_MAX_SLEEP_MS=2000
DISBURSEMENT_FEE_FIX=2100
PPN_VALUE=11

# Required response-signing key in every environment. Mount this file; do not
# commit it. Passphrase may be supplied directly or by deployment secret.
KEY_FILE_PRIVATE=/absolute/path/to/refund-private-key.pem
KEY_FILE_PRIVATE_PASS=

# Backoffice and Iluma secrets. In staging/production each is required. Prefer
# the *_FILE form for Kubernetes-mounted secrets; never set both forms.
SERVICE_TO_SERVICE_SECRET=
# SERVICE_TO_SERVICE_SECRET_FILE=/run/secrets/refund-service-key
ILUMA_TOKEN=
# ILUMA_TOKEN_FILE=/run/secrets/iluma-token
